# CinemaSeek .env — copy to .env and fill in your keys
# Multiple providers are supported; LLMGatewayV7 uses whichever are available.
# At minimum, provide ONE LLM API key.

# ── Google Gemini — MULTIPLE KEY SUPPORT ─────────────────────────────────────
#
# The gateway pools ALL keys you provide and rotates through them automatically:
#   - Round-robin across all keys for every request
#   - On 429 (quota exceeded), that key is cooled down for 60s, next key is used
#   - Works for BOTH chat requests AND embeddings
#
# You can provide 1 to 20 keys:
#   GEMINI_API_KEY        — primary / only key (required if using Gemini)
#   GEMINI_API_KEY_1 … _6 — additional keys for rotation (all optional)
#
# How to get free Gemini keys:
#   https://aistudio.google.com/apikey  (sign in with different Google accounts)

GEMINI_API_KEY=your_gemini_api_key_here

# Uncomment and fill in as many as you have:
# GEMINI_API_KEY_1=your_second_gemini_key
# GEMINI_API_KEY_2=your_third_gemini_key
# GEMINI_API_KEY_3=your_fourth_gemini_key
# GEMINI_API_KEY_4=your_fifth_gemini_key
# GEMINI_API_KEY_5=your_sixth_gemini_key
# GEMINI_API_KEY_6=your_seventh_gemini_key

# Optional: pin a specific Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Other LLM providers (all optional, used as fallback if Gemini is down) ──

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter (access to many models via one key)
# OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# NVIDIA NIM
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Groq (fast inference)
# GROQ_API_KEY=your_groq_api_key_here

# Cerebras
# CEREBRAS_API_KEY=your_cerebras_api_key_here

# GitHub Models
# GITHUB_ACCESS_TOKEN=your_github_token_here

# ── Search (optional — enables web_search tool) ──────────────────────────────
# TAVILY_API_KEY=your_tavily_api_key_here

# ── Embedding model (do NOT change after first corpus index build) ────────────
# The FAISS index dimension is fixed once built. Changing the model invalidates
# every stored embedding and requires re-running index_corpus.py from scratch.
# EMBED_OLLAMA_MODEL=nomic-embed-text
# EMBED_FALLBACK_PROVIDER=gemini
# EMBED_FALLBACK_MODEL=gemini-embedding-001

# ── Gateway config ────────────────────────────────────────────────────────────
GATEWAY_V7_PORT=8107
LLM_GATEWAY_V7_URL=http://localhost:8107

# Provider failover order (left = highest priority)
# LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github
# ROUTER_ORDER=github,groq,cerebras,gemini
